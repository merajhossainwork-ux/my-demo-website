@import "tailwindcss";
@custom-variant dark (&:where(.dark, .dark *));

:root {
  --accent: #FF4D1C;
  --accent-rgb: 255, 77, 28;
  --bg-primary: #0A0A0A;
  --bg-secondary: #141414;
  --text-primary: #F2F0EB;
  --text-muted: #A39E93;
  --font-display: 'Anton', 'Bebas Neue', sans-serif;
  --font-condensed: 'Bebas Neue', 'Anton', sans-serif;
  --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

@layer base {
  html {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
  }

  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    overflow-x: hidden;
  }
}

.font-display {
  font-family: var(--font-display);
  letter-spacing: 0.01em;
}

.font-condensed {
  font-family: var(--font-condensed);
  letter-spacing: 0.03em;
}

.font-body {
  font-family: var(--font-body);
}

.font-mono-num {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.text-outline {
  -webkit-text-stroke: 1.5px rgba(242, 240, 235, 0.28);
  color: transparent;
}

.text-outline-accent {
  -webkit-text-stroke: 1.5px var(--accent);
  color: transparent;
}

@keyframes spin-slow {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.animate-spin-slow {
  animation: spin-slow 18s linear infinite;
}

@keyframes grain-shift {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-2%, 2%); }
  40% { transform: translate(2%, -2%); }
  60% { transform: translate(-1%, -1%); }
  80% { transform: translate(1%, 2%); }
}

.animate-grain {
  animation: grain-shift 6s steps(6) infinite;
}

@media (prefers-reduced-motion: reduce) {
  .animate-spin-slow,
  .animate-grain {
    animation: none !important;
  }
}

/* Hide scrollbar for horizontal gallery while preserving scrollability */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}


